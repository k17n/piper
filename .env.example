# Copy to ~/.jobtracker/.env (or ./.env) and adjust.
LLM_PROVIDER=ollama              # ollama | anthropic (anthropic not implemented yet)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct # fits fully in 8 GB VRAM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GHOST_DAYS=30
SYNC_INTERVAL_HOURS=6
BACKFILL_DAYS=180
INCLUDE_SENT_THREADS=true        # whole threads you sent mail in
FOLLOW_COMPANY_DOMAINS=true      # all mail from companies you're in a hiring process with
ALWAYS_INCLUDE=                  # e.g. acme.com,jane@startup.io
ALWAYS_IGNORE=                   # e.g. newsletter.example.com
GMAIL_EXTRA_QUERY=               # e.g. from:acme.com OR subject:"portfolio review"
# Your own never-job subject patterns go in never_job_subjects.txt next to this file.
